config_version=5

[application]

config/name="TorchFlame"
run/main_scene="uid://cosvue7y1iv6v"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
boot_splash/stretch_mode=4
boot_splash/image="uid://bjk8vums6fo2s"
config/icon="uid://ct3dp3r0egyew"
boot_splash/minimum_display_time=1000

[audio]

buses/default_bus_layout="uid://ghtriycajf6f"

[autoload]

TitleAudio="*uid://dwqp1uygrc4yq"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Torchlight"

[editor_plugins]

enabled=PackedStringArray("res://addons/SimpleDungeons/plugin.cfg")

